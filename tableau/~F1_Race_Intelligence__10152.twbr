            <zone h='83372' id='4' paired-zone-id='3' removable='false' type-v2='flipboard' w='100000' x='0' y='16628'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='1. Global F1 Overview: 10 teams, 17 seasons, 6,464 race outcomes and 29 circuits' captured-sheet='KPI Overview' id='1' />
                  <story-point caption='2. Global Driver Distribution: Bahrain hosts 115 of 334 Grands Prix across 21 nations' captured-sheet='Global Driver Distribution' id='2' />
                  <story-point caption='3. Driver Reliability: 396 DNFs; Engine failures lead (73) and Carlos Sainz retires most (34)' captured-sheet='Driver Reliability Analysis' id='3' />
                  <story-point caption='4. Driver Performance: Max Verstappen leads on 4,640 points, Lewis Hamilton next on 4,491' captured-sheet='Driver Performance' id='4' />
                  <story-point caption='5. Team Performance: Red Bull Racing (8,006) edges Mercedes (7,790) on total points' captured-sheet='Team Performance Ranking' id='5' />
                  <story-point caption='6. Championship Trends: most team points by season: Red Bull Racing 8, Mercedes 7, McLaren 2' captured-sheet='Team Championship Performance Analysis' id='6' />
                  <story-point caption='7. Tyre Strategy: Soft 31.5%, Medium 30.8%, Hard 30.4%, Intermediate 7.3% of laps' captured-sheet='Tyre Compound Usage Distribution' id='7' />
                  <story-point caption='8. Country-wise Participation: Bahrain 115, USA 20, Monaco 17 Grands Prix lead the calendar' captured-sheet='Country-wise Race Participation' id='8' />
                  <story-point caption='9. Podium Achievements: Max Verstappen (187) and Lewis Hamilton (174) lead the podium count' captured-sheet='Podium Achievements by Driver and Team' id='9' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
        </zone>
      </zones>
      <simple-id uuid='{CAD3ECF4-E379-46B9-9F30-DF69CD97D741}' />
    </dashboard>
